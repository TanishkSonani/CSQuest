# Installed dependencies and downloaded speech models (kept locally).
node_modules/
/tooling/transcription/
/tooling/archive/
/tooling/staging/
/tooling/legacy/

# Runtime state and diagnostics; completed transcripts remain versioned.
/runtime/*
!/runtime/.gitkeep
/dist/
# Private, durable account records. Keep these separate from disposable runtime logs.
/data/accounts/*
!/data/accounts/.gitkeep
*.log
**/data/services.json
**/data/watcher.json
**/data/source-analysis/worker.json
**/data/source-analysis/status.json
**/data/source-analysis/transcribe.py
**/data/source-analysis/pdf-text/
**/data/source-analysis/COURSE_STATUS.md
*.before-ssd-resume-*
*.before-batch.*
*.tmp
__pycache__/
*.py[cod]

# Test output; retain an empty output directory for direct browser checks.
/qa-results/*
!/qa-results/.gitkeep

# Local configuration and operating-system files.
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini
