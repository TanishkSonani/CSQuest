{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSQuest subject manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "shortName", "description", "icon", "color", "status", "sourceFolder", "lectureCount", "storageKey"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "shortName": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "icon": {"type": "string", "minLength": 1},
    "color": {"enum": ["green", "blue", "purple", "orange", "teal", "pink"]},
    "order": {"type": "integer", "minimum": 0},
    "status": {"enum": ["available", "planned"]},
    "sourceFolder": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "lectureCount": {"type": "integer", "minimum": 0},
    "storageKey": {"type": "string", "minLength": 1},
    "builder": {"type": "string", "pattern": "^authoring/[a-z0-9-]+\\.mjs$"}
  }
}
