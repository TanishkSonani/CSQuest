{
  "name": "csquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/server.mjs",
    "db:local": "node scripts/db-local.mjs",
    "db:stop": "node scripts/db-local.mjs stop",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:import": "node scripts/db-import.mjs",
    "db:export": "node scripts/db-transfer.mjs export",
    "db:restore": "node scripts/db-transfer.mjs restore",
    "db:verify": "node scripts/db-transfer.mjs verify",
    "db:alembic": "python -m alembic upgrade head",
    "db:deploy": "python -m alembic upgrade head && npm run db:import",
    "db:setup": "npm run db:local && npm run db:migrate && npm run db:import",
    "watch": "node scripts/watch.mjs",
    "sync": "node scripts/sync.mjs",
    "catalog": "node scripts/catalog.mjs",
    "build:lessons": "node scripts/build-lessons.mjs",
    "build:algo": "node scripts/build-algo-lessons.mjs",
    "validate": "node scripts/validate-courses.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
