# Copy to .env for an existing PostgreSQL database, or run npm run db:setup
# to create the isolated local PostgreSQL instance on port 55432.
DATABASE_URL=postgresql://csquest:YOUR_PASSWORD@127.0.0.1:55432/csquest
APP_HOST=127.0.0.1
APP_PORT=4173
# Production requires HTTPS at the reverse proxy (secure session cookies).
NODE_ENV=development
# Optional: directory containing initdb and pg_ctl for npm run db:local.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin

# Optional durable directory for generated podcast MP3s and timing manifests.
# Defaults to data/podcasts in the application directory.
# PODCAST_ROOT=/srv/csquest-data/podcasts

# Private Library: immutable platform-owner account UUID (required; fails closed).
# LIBRARY_OWNER_ID=00000000-0000-0000-0000-000000000000
# Optional root administrator UUID. Defaults to LIBRARY_OWNER_ID.
# Admins can create Admin accounts; this configured bootstrap account is protected.
# PLATFORM_ADMIN_ID=00000000-0000-0000-0000-000000000000
# Production persistent roots. Fixed allocations: Boot 35 GiB; Block 125 GiB.
# Local development defaults to ignored runtime/library/{boot,block}.
# LIBRARY_BOOT_ROOT=/var/lib/csquest-library
# LIBRARY_BLOCK_ROOT=/srv/csquest-data/library

# Optional private OCI Object Storage drive. All connection settings stay here.
# Existing bucket objects are indexed in place; new uploads use the managed prefix.
# LIBRARY_OBJECT_BUCKET=Stuff
# LIBRARY_OBJECT_NAMESPACE=your-namespace
# LIBRARY_OBJECT_REGION=eu-frankfurt-1
# LIBRARY_OBJECT_PREFIX=csquest-library/
# Initial decimal GB limit. Admin GUI changes persist in PostgreSQL.
# LIBRARY_OBJECT_QUOTA_GB=20
# LIBRARY_OBJECT_AUTH=config_file
# LIBRARY_OBJECT_CONFIG_FILE=/etc/csquest/oci/config
# LIBRARY_OBJECT_PROFILE=DEFAULT
# Alternatively use LIBRARY_OBJECT_AUTH=instance_principal with bucket-scoped IAM.
# Only a maximum 16 MiB part per active upload is staged on disk, never whole files.
# LIBRARY_OBJECT_STAGE_ROOT=/var/lib/csquest-library/.object-stage
