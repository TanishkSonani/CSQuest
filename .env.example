# Copy to .env for an existing PostgreSQL database, or run npm run db:setup
# to create the isolated local PostgreSQL instance on port 55432.
DATABASE_URL=postgresql://csquest:YOUR_PASSWORD@127.0.0.1:55432/csquest
APP_HOST=127.0.0.1
APP_PORT=4173
# Production requires HTTPS at the reverse proxy (secure session cookies).
NODE_ENV=development
# Optional: directory containing initdb and pg_ctl for npm run db:local.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin

# Optional durable directory for generated podcast MP3s and timing manifests.
# Defaults to data/podcasts in the application directory.
# PODCAST_ROOT=/srv/csquest-data/podcasts
